<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.CombatMeter</RootNamespace>
    <AssemblyName>Stellar.CombatMeter</AssemblyName>
    <Version>1.8.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <!-- Stellar.Abstractions resolves from the framework SOURCE when this repo sits inside the DevKit
       superproject (../../framework present), and from the published package otherwise. Reason: the
       plugin is deployed straight to the owner's client from a local build and is never released, so it
       must be able to use a framework API added in the same session — waiting for a NuGet publish is not
       part of this workflow. A standalone clone (CI, contributors) finds no ../../framework and keeps the
       PackageReference path below, byte-for-byte as before. -->
  <PropertyGroup>
    <StellarAbstractionsSrc>$(MSBuildThisFileDirectory)../../framework/src/Stellar.Abstractions/Stellar.Abstractions.csproj</StellarAbstractionsSrc>
    <UseLocalStellarAbstractions Condition="Exists('$(StellarAbstractionsSrc)')">true</UseLocalStellarAbstractions>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalStellarAbstractions)' == 'true'">
    <ProjectReference Include="$(StellarAbstractionsSrc)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalStellarAbstractions)' != 'true'">
    <PackageReference Include="Stellar.Abstractions" Version="1.17.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Stellar.PluginContracts" Version="1.9.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="1.5.0" />
    <!-- Managed ECDSA. System.Security.Cryptography's ECDsa is OS/CNG-backed and its SignData throws
         NTE_NOT_SUPPORTED (0x80090029) under Wine/Proton, breaking signed uploads + per-install claims
         (P2-SIGNING, 2026-06-30). BouncyCastle is pure-managed — works identically on Windows AND Wine.
         Merged into the single plugin DLL by ILRepack.targets on Release (the deploy copies only that
         one DLL; the framework loads plugins via Assembly.LoadFile with no sibling-dependency probing). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.5.0" />
    <!-- Build-only: merges BouncyCastle into Stellar.CombatMeter.dll on Release (see ILRepack.targets).
         PrivateAssets=all so it never flows to the test project's transitive build. -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/mic.png" LogicalName="Stellar.CombatMeter.mic.png" />
    <EmbeddedResource Include="Resources/headphone.png" LogicalName="Stellar.CombatMeter.headphone.png" />
    <EmbeddedResource Include="Resources/mute.png" LogicalName="Stellar.CombatMeter.mute.png" />
    <EmbeddedResource Include="Resources/settings-gear.png" LogicalName="Stellar.CombatMeter.settings-gear.png" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="Stellar.CombatMeter.Tests" />
  </ItemGroup>
</Project>
